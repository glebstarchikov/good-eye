# All optional. good-eye reads these from the environment; nothing loads a .env file.

# Where the library lives. Default: ~/.good-eye/data
# GOOD_EYE_DATA_DIR=

# The claude CLI the librarian runs, and the model it asks for. Defaults: claude, sonnet
# GOOD_EYE_CLAUDE_BIN=
# GOOD_EYE_MODEL=

# Capture budgets in milliseconds; src/capture/web.ts explains each. Defaults: 30000, 30000, 45000
# GOOD_EYE_NAV_TIMEOUT_MS=
# GOOD_EYE_DOM_TIMEOUT_MS=
# GOOD_EYE_PARSE_TIMEOUT_MS=

# Set to 1 for unattended runs (collectors, webhooks). A site that blocks automated browsers is then
# reported as blocked for a person to capture, instead of retried in a visible Chrome window. Default: off
# GOOD_EYE_BACKGROUND=
